<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout">

    <Dialog id="CostCenterForm_Dialog"
            resizable="true"
            draggable="true"
            contentHeight="100%"
            contentWidth="100%"
            afterClose="onDialogAfterClose">

        <content>
            <IconTabBar id="CostCenterForm_IconTabBar"
                        expandable="false"
                        expanded="true"
                        class="sapUiResponsiveContentPadding">

                <items>

                    <!-- Header Data Tab -->
                    <IconTabFilter id="Tab_Initial"
                                   text="Header Data"
                                   icon="sap-icon://add-contact"
                                   enabled="true">

                        <f:SimpleForm id="SimpleForm_Initial"
                                      editable="true"
                                      layout="ResponsiveGridLayout"
                                      labelSpanXL="4"
                                      labelSpanL="3"
                                      labelSpanM="12"
                                      labelSpanS="12"
                                      emptySpanXL="0"
                                      emptySpanL="0"
                                      emptySpanM="0"
                                      emptySpanS="0"
                                      columnsXL="2"
                                      columnsL="2"
                                      columnsM="1"
                                      class="sapUiSmallMarginTop sapUiSmallMarginBottom">

                            <f:content>

                                <Toolbar id="CCForm_Toolbar1" visible="false"/>

                                <Label id="CCForm_Label1" text="Controlling Area" labelFor="controllingArea"/>
                                <Input id="controllingArea"
                                       required="true"
                                       value="{DataModel>/controllingArea}"
                                       change="validateControllingArea"
                                       liveChange="validateControllingArea"
                                       showValueHelp="true"
                                       valueHelpRequest="onValueHelpRequestControllingArea"/>

                                <Label id="CCForm_Label2" text="Cost Center" labelFor="costCenter"/>
                                <Input id="costCenter"
                                       required="true"
                                       value="{DataModel>/costCenter}"
                                       change="validateCostCenter"
                                       liveChange="validateCostCenter"
                                       valueHelpRequest="onValueHelpRequestCostCenter"/>

                                <Toolbar id="CCForm_Toolbar2" visible="false"/>

                                <Label id="CCForm_Label3" text="Valid From" labelFor="validFrom"/>
                                <DatePicker id="validFrom"
                                            required="true"
                                            value="{DataModel>/validFrom}"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="dd-MM-yyyy"
                                            change="onInputValueChange"/>

                                <Label id="CCForm_Label" text="Valid To" labelFor="validTo"/>
                                <DatePicker id="validTo"
                                            required="true"
                                            value="{DataModel>/validTo}"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="dd-MM-yyyy"
                                            change="onInputValueChange"/>

                            </f:content>
                        </f:SimpleForm>
                    </IconTabFilter>

                    <!-- Basic Data Tab -->
                    <IconTabFilter id="Tab_BasicData"
                                   text="Basic Data"
                                   icon="sap-icon://business-card"
                                   enabled="false">

                        <f:SimpleForm id="SimpleForm_Basic"
                                      editable="true"
                                      layout="ResponsiveGridLayout"
                                      labelSpanXL="5"
                                      labelSpanL="4"
                                      labelSpanM="12"
                                      labelSpanS="12"
                                      emptySpanXL="0"
                                      emptySpanL="0"
                                      emptySpanM="0"
                                      emptySpanS="0"
                                      columnsXL="2"
                                      columnsL="2"
                                      columnsM="1"
                                      class="sapUiSmallMarginTop sapUiSmallMarginBottom">

                            <f:content>

                                <core:Title id="CCForm_Title4" text="Names"/>
                                <Label id="CCForm_Label4" text="Name" labelFor="name"/>
                                <Input id="name"
                                required="true"
                                       value="{DataModel>/name}"
                                       change="validateName"
                                       liveChange="validateName"/>
                                <core:Title id="CCForm_Title10"/>
                                <Label id="CCForm_Label5" text="Description" labelFor="description"/>
                                <Input id="description"
                                required="true"
                                       value="{DataModel>/description}"
                                       change="validateDescription"
                                       liveChange="validateDescription"/>

                                <core:Title id="CCForm_Title5" text="Basic Data"/>
                                <Label id="CCForm_Label6" text="User Responsible" labelFor="userResponsible"/>
                                <Input id="userResponsible"
                                       value="{DataModel>/userResponsible}"
                                       change="onInputValueChange"/>

                                <Label id="CCForm_Label7" text="Person Responsible" labelFor="personResponsible"/>
                                <Input id="personResponsible"
                                       required="true"
                                       value="{DataModel>/personResponsible}"
                                       change="validatePersonResponsible"
                                       liveChange="validatePersonResponsible"
                                       showValueHelp="true"
                                       valueHelpRequest="onValueHelpRequestPersonResponsible"/>

                                <Label id="CCForm_Label8" text="Department" labelFor="department"/>
                                <Input id="department"
                                       value="{DataModel>/department}"
                                       change="validateDepartment"
                                       liveChange="validateDepartment"/>

                                <Label id="CCForm_Label9" text="Cost Center Category" labelFor="costCenterCategory"/>
                                <Input id="costCenterCategory"
                                       required="true"
                                       value="{DataModel>/costCenterCategory}"
                                       change="validateCostCenterCategory"
                                       liveChange="validateCostCenterCategory"
                                       showValueHelp="true"
                                       valueHelpRequest="onValueHelpRequestCostCenterCategory"/>

                                <Label id="CCForm_Label10" text="Hierarchy Area" labelFor="hierarchyArea"/>
                                <Input id="hierarchyArea"
                                       required="true"
                                       value="{DataModel>/hierarchyArea}"
                                       change="validateHierarchyArea"
                                       liveChange="validateHierarchyArea"
                                       showValueHelp="true"
                                       valueHelpRequest="onValueHelpRequestHierarchyArea"/>

                                <core:Title id="CCForm_Title11"/>

                                <Label id="CCForm_Label11" text="Company Code" labelFor="companyCode"/>
                                <Input id="companyCode"
                                       required="true"
                                       value="{DataModel>/companyCode}"
                                       change="validateCompanyCode"
                                       liveChange="validateCompanyCode"
                                       showValueHelp="true"
                                       valueHelpRequest="onValueHelpRequestCompanyCode"/>

                                <Label id="CCForm_Label12" text="Business Area" labelFor="businessArea"/>
                                <Input id="businessArea"
                                       value="{DataModel>/businessArea}"
                                       change="validateBusinessArea"
                                       liveChange="validateBusinessArea"/>

                                <Label id="CCForm_Label13" text="Currency" labelFor="currency"/>
                                <Input id="currency"
                                       required="true"
                                       value="{DataModel>/currency}"
                                       change="validateCurrency"
                                       liveChange="validateCurrency"
                                       showValueHelp="true"
                                       valueHelpRequest="onValueHelpRequestCurrency"/>

                                <Label id="CCForm_Label14" text="Profit Center" labelFor="profitCenter"/>
                                <Input id="profitCenter"
                                       value="{DataModel>/profitCenter}"
                                       change="validateProfitCenter"
                                       liveChange="validateProfitCenter"
                                       showValueHelp="true"
                                       valueHelpRequest="onValueHelpRequestProfitCenter"/>

                            </f:content>
                        </f:SimpleForm>
                    </IconTabFilter>

                    <!-- Control Tab -->
                    <IconTabFilter id="Tab_Control"
                                   text="Control"
                                   icon="sap-icon://settings"
                                   enabled="false">

                        <f:SimpleForm id="SimpleForm_Control"
                                      editable="true"
                                      layout="ResponsiveGridLayout"
                                      labelSpanXL="5"
                                      labelSpanL="4"
                                      labelSpanM="12"
                                      labelSpanS="12"
                                      emptySpanXL="0"
                                      emptySpanL="0"
                                      emptySpanM="0"
                                      emptySpanS="0"
                                      columnsXL="2"
                                      columnsL="2"
                                      columnsM="1"
                                      class="sapUiSmallMarginTop sapUiSmallMarginBottom">

                            <f:content>

                                <Toolbar id="CCForm_Toolbar3" visible="false"/>

                                <Label id="CCForm_Label15" text="Record Quantity" tooltip="Indicator defining whether the system issues a message if no quantity or quantity unit is specified for commitment or actual postings."/>
                                <CheckBox id="recordQuantity" selected="{DataModel>/recordQuantity}" tooltip="Indicator defining whether the system issues a message if no quantity or quantity unit is specified for commitment or actual postings."/>

                                <Label id="CCForm_Label16" text="Actual Primary Costs" tooltip=" Indicator defining whether the system issues a message if no quantity or quantity unit is specified for commitment or actual postings."/>
                                <CheckBox id="actualPrimaryCosts" selected="{DataModel>/actualPrimaryCosts}" tooltip=" Indicator defining whether the system issues a message if no quantity or quantity unit is specified for commitment or actual postings."/>

                                <Label id="CCForm_Label17" text="Actual Secondary Costs" tooltip=" Indicator controlling whether the cost center is locked against postings of secondary costs"/>
                                <CheckBox id="actualSecondaryCosts" selected="{DataModel>/actualSecondaryCosts}" tooltip=" Indicator controlling whether the cost center is locked against postings of secondary costs"/>

                                <Label id="CCForm_Label18" text="Plan Primary Costs" tooltip="Indicator defining whether a cost center is locked for planning with direct costs"/>
                                <CheckBox id="planPrimaryCosts" selected="{DataModel>/planPrimaryCosts}" tooltip="Indicator defining whether a cost center is locked for planning with direct costs"/>

                                <Toolbar id="CCForm_Toolbar4" visible="false"/>

                                <Label id="CCForm_Label19" text="Plan Secondary Costs" tooltip="Defines whether a cost center is locked for planning with secondary costs."/>
                                <CheckBox id="planSecondaryCosts" selected="{DataModel>/planSecondaryCosts}" tooltip="Defines whether a cost center is locked for planning with secondary costs."/>

                                <Label id="CCForm_Label20" text="Actual Revenue" tooltip="Indicator defining whether a cost center is locked for posting with revenues"/>
                                <CheckBox id="actualRevenue" selected="{DataModel>/actualRevenue}" tooltip="Indicator defining whether a cost center is locked for posting with revenues"/>

                                <Label id="CCForm_Label21" text="Plan Revenue" tooltip="Indicator controlling whether a cost center is locked for planning with revenues."/>
                                <CheckBox id="planRevenue" selected="{DataModel>/planRevenue}" tooltip="Indicator controlling whether a cost center is locked for planning with revenues."/>

                                <Label id="CCForm_Label22" text="Commitment Update" tooltip="Indicator defining whether a commitment for the cost center is updated. If the indicator is active, no commitments can be updated for the relevant cost center"/>
                                <CheckBox id="commitmentUpdate" selected="{DataModel>/commitmentUpdate}" tooltip="Indicator defining whether a commitment for the cost center is updated. If the indicator is active, no commitments can be updated for the relevant cost center"/>

                            </f:content>
                        </f:SimpleForm>
                    </IconTabFilter>

                </items>
            </IconTabBar>
        </content>

        <footer>
            <OverflowToolbar id="ots1Toolbar">

                <Button id="ccMsgButton"
                        icon="sap-icon://message-popup"
                        text="{= ${ccMessageModel>/messages}.length }"
                        press="onCCMessagePopoverPress">
                    <dependents>
                        <MessagePopover id="ccMsgPopover"
                                        items="{ccMessageModel>/messages}">
                            <MessageItem id="CCForm_MessageItem"
                                         type="{ccMessageModel>type}"
                                         title="{ccMessageModel>title}"
                                         description="{ccMessageModel>description}"/>
                        </MessagePopover>
                    </dependents>
                </Button>

                <ToolbarSpacer id="ts1Spacer"/>

                <Button id="CCForm_Button"
                        text="Submit"
                        type="Emphasized"
                        icon="sap-icon://save"
                        press="onSubmitCostCenter"/>

                <Button id="CCForm_Button1"
                        text="Cancel"
                        icon="sap-icon://decline"
                        press="onCancelCostCenter"/>

            </OverflowToolbar>
        </footer>

    </Dialog>
</core:FragmentDefinition>

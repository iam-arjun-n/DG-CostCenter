<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout">
    
    <Dialog id="CostCenterForm_Dialog" resizable="true" draggable="true" contentHeight="100%" contentWidth="100%" afterClose="onDialogAfterClose">
        <content>
            <IconTabBar id="CostCenterForm_IconTabBar" class="sapUiResponsiveContentPadding">
                <items>
                    <IconTabFilter id="Tab_Initial" text="Initial Screen" icon="sap-icon://add-contact" enabled="true">
                        <f:SimpleForm id="SimpleForm_Initial" editable="true" layout="ResponsiveGridLayout"
                                      labelSpanXL="4" labelSpanL="3" labelSpanM="12" labelSpanS="12"
                                      adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0"
                                      columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                            <f:content>
                                <Label id="_IDGenLabel1" text="Controlling Area" labelFor="controllingArea"/>
                                <Input id="controllingArea" required="true" value="{DataModel>/controllingArea}" change="onInputValueChange" showValueHelp="true"
    valueHelpRequest="onValueHelpRequestControllingArea"/>

                                <Label id="_IDGenLabel2" text="Cost Center" labelFor="costCenter"/>
                                <Input id="costCenter" required="true" value="{DataModel>/costCenter}" change="onInputValueChange" showValueHelp="true" valueHelpRequest="onValueHelpRequestCostCenter"/>

                                <Label id="_IDGenLabel3" text="Valid From" labelFor="validFrom"/>
                                <DatePicker id="validFrom" required="true" value="{DataModel>/validFrom}" valueFormat="yyyy-MM-dd" displayFormat="long" change="onInputValueChange"/>
                            </f:content>
                        </f:SimpleForm>
                    </IconTabFilter>

                    <!-- Basic Data Tab -->
                    <IconTabFilter id="Tab_BasicData" text="Basic Data" icon="sap-icon://business-card" enabled="false">
                        <f:SimpleForm id="SimpleForm_Basic" editable="true" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="4" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                            <f:content >
                            <core:Title id="_IDVendorTitle4"  />
                                <Label id="_IDGenLabel4" text="Name" labelFor="name"  />
                                <Input id="name" value="{DataModel>/name}" change="onInputValueChange"/>

                                <Label id="_IDGenLabel5" text="Description" labelFor="description"  />
                                <Input id="description" value="{DataModel>/description}" change="onInputValueChange"/>
                                
                                <Label id="_IDGenLabel6" text="User Responsible" labelFor="userResponsible"  />
                                <Input id="userResponsible" value="{DataModel>/userResponsible}" change="onInputValueChange"/>
                                
                                <Label id="_IDGenLabel7" text="Person Responsible" labelFor="personResponsible"  />
                                <Input id="personResponsible" required="true" value="{DataModel>/personResponsible}" change="onInputValueChange"/>
                                
                                <Label id="_IDGenLabel8" text="Department" labelFor="department"  />
                                <Input id="department" value="{DataModel>/department}" change="onInputValueChange"/>
                                
                                <Label id="_IDGenLabel9" text="Cost Center Category" labelFor="costCenterCategory"  />
                                <Input id="costCenterCategory" required="true" value="{DataModel>/costCenterCategory}" change="onInputValueChange" showValueHelp="true" valueHelpRequest="onValueHelpRequestCostCenterCategory"/>
                                <core:Title id="_IDVendorTitle5"/>
                                <Label id="_IDGenLabel10" text="Hierarchy Area" labelFor="hierarchyArea"  />
                                <Input id="hierarchyArea" required="true" value="{DataModel>/hierarchyArea}" change="onInputValueChange" showValueHelp="true" valueHelpRequest="onValueHelpRequestHierarchyArea"/>
                                
                                <Label id="_IDGenLabel11" text="Company Code" labelFor="companyCode"  />
                                <Input id="companyCode" required="true" value="{DataModel>/companyCode}" change="onInputValueChange" showValueHelp="true" valueHelpRequest="onValueHelpRequestCompanyCode" />
                                
                                <Label id="_IDGenLabel12" text="Business Area" labelFor="businessArea"  />
                                <Input id="businessArea" value="{DataModel>/businessArea}" change="onInputValueChange"/>
                                
                                <Label id="_IDGenLabel13" text="Currency" labelFor="currency"  />
                                <Input id="currency" required="true" value="{DataModel>/currency}" change="onInputValueChange" showValueHelp="true" valueHelpRequest="onValueHelpRequestCurrency"/>
                                
                                <Label id="_IDGenLabel14" text="Profit Center" labelFor="profitCenter"  />
                                <Input id="profitCenter" value="{DataModel>/profitCenter}" change="onInputValueChange" showValueHelp="true" valueHelpRequest="onValueHelpRequestProfitCenter"/>
                            </f:content>
                        </f:SimpleForm>
                        
                    </IconTabFilter>
                </items>
            </IconTabBar>
        </content>

        <buttons>
            <Button id="_IDGenButton" text="Submit" type="Emphasized" press="onSubmitCostCenter"/>
            <Button id="_IDGenButton1" text="Cancel" press="onCancelCostCenter"/>
        </buttons>
    </Dialog>
</core:FragmentDefinition>
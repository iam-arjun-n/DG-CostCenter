<core:FragmentDefinition xmlns="sap.m"
        xmlns:core="sap.ui.core"
        xmlns:f="sap.ui.layout.form"
        xmlns:l="sap.ui.layout">

        <Dialog id="CostCenterForm_Dialog" resizable="true" draggable="true" contentHeight="100%" contentWidth="100%" afterClose="onDialogAfterClose">
                <content>
                        <IconTabBar id="CostCenterForm_IconTabBar" class="sapUiResponsiveContentPadding">
                                <items>
                                        <IconTabFilter id="Tab_Initial" text="Header Data" icon="sap-icon://add-contact" enabled="true">
                                                <f:SimpleForm id="SimpleForm_Initial" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="3" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                                                        <f:content>
                                                                <Label id="CCForm_Label1" text="Controlling Area" labelFor="controllingArea"/>
                                                                <Input id="controllingArea" required="true" value="{DataModel>/controllingArea}" change="validateControllingArea" liveChange="validateControllingArea" showValueHelp="true" valueHelpRequest="onValueHelpRequestControllingArea"/>

                                                                <Label id="CCForm_Label2" text="Cost Center" labelFor="costCenter"/>
                                                                <Input id="costCenter" required="true" value="{DataModel>/costCenter}" change="validateCostCenter" liveChange="validateCostCenter" showValueHelp="true" valueHelpRequest="onValueHelpRequestCostCenter"/>

                                                                <Label id="CCForm_Label3" text="Valid From" labelFor="validFrom"/>
                                                                <DatePicker id="validFrom" required="true" value="{DataModel>/validFrom}" valueFormat="yyyy-MM-dd" displayFormat="long" change="onInputValueChange"/>

                                                                <Label id="CCForm_Label" text="Valid To" labelFor="validTo"/>
                                                                <DatePicker id="validTo" required="true" value="{DataModel>/validTo}" valueFormat="yyyy-MM-dd" displayFormat="long" change="onInputValueChange"/>
                                                        </f:content>
                                                </f:SimpleForm>
                                        </IconTabFilter>

                                        <!-- Basic Data Tab -->
                                        <IconTabFilter id="Tab_BasicData" text="Basic Data" icon="sap-icon://business-card" enabled="false">
                                                <f:SimpleForm id="SimpleForm_Basic" editable="true" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="4" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                                                        <f:content >
                                                                <core:Title id="CCForm_Title4" />
                                                                <Label id="CCForm_Label4" text="Name" labelFor="name" />
                                                                <Input id="name" value="{DataModel>/name}" change="validateName" liveChange="validateName"/>

                                                                <Label id="CCForm_Label5" text="Description" labelFor="description" />
                                                                <Input id="description" value="{DataModel>/description}" liveChange="validateDescription" change="validateDescription"/>

                                                                <Label id="CCForm_Label6" text="User Responsible" labelFor="userResponsible" />
                                                                <Input id="userResponsible" value="{DataModel>/userResponsible}" change="onInputValueChange"/>

                                                                <Label id="CCForm_Label7" text="Person Responsible" labelFor="personResponsible" />
                                                                <Input id="personResponsible" required="true" value="{DataModel>/personResponsible}" change="validatePersonResponsible" liveChange="validatePersonResponsible"/>

                                                                <Label id="CCForm_Label8" text="Department" labelFor="department" />
                                                                <Input id="department" value="{DataModel>/department}" change="validateDepartment" liveChange="validateDepartment"/>

                                                                <Label id="CCForm_Label9" text="Cost Center Category" labelFor="costCenterCategory" />
                                                                <Input id="costCenterCategory" required="true" value="{DataModel>/costCenterCategory}" change="validateCostCenterCategory" liveChange="validateCostCenterCategory" showValueHelp="true" valueHelpRequest="onValueHelpRequestCostCenterCategory"/>

                                                                <core:Title id="CCForm_Title5"/>
                                                                <Label id="CCForm_Label10" text="Hierarchy Area" labelFor="hierarchyArea" />
                                                                <Input id="hierarchyArea" required="true" value="{DataModel>/hierarchyArea}" change="validateHierarchyArea" liveChange="validateHierarchyArea" showValueHelp="true" valueHelpRequest="onValueHelpRequestHierarchyArea"/>

                                                                <Label id="CCForm_Label11" text="Company Code" labelFor="companyCode" />
                                                                <Input id="companyCode" required="true" value="{DataModel>/companyCode}" change="validateCompanyCode" liveChange="validateCompanyCode" showValueHelp="true" valueHelpRequest="onValueHelpRequestCompanyCode" />

                                                                <Label id="CCForm_Label12" text="Business Area" labelFor="businessArea" />
                                                                <Input id="businessArea" value="{DataModel>/businessArea}" change="validateBusinessArea" liveChange="validateBusinessArea"/>

                                                                <Label id="CCForm_Label13" text="Currency" labelFor="currency" />
                                                                <Input id="currency" required="true" value="{DataModel>/currency}" change="validateCurrency" liveChange="validateCurrency" showValueHelp="true" valueHelpRequest="onValueHelpRequestCurrency"/>

                                                                <Label id="CCForm_Label14" text="Profit Center" labelFor="profitCenter" />
                                                                <Input id="profitCenter" value="{DataModel>/profitCenter}" change="validateProfileCenter" liveChange="validateProfileCenter" showValueHelp="true" valueHelpRequest="onValueHelpRequestProfitCenter"/>
                                                        </f:content>
                                                </f:SimpleForm>

                                        </IconTabFilter>

                                        <IconTabFilter id="Tab_Control" text="Control" icon="sap-icon://settings" enabled="false">
                                                <f:SimpleForm id="SimpleForm_Control" editable="true" layout="ResponsiveGridLayout" labelSpanXL="5" labelSpanL="4" labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="2" columnsL="2" columnsM="1" singleContainerFullSize="false">
                                                        <f:content>
                                                                <core:Title id="CCForm_Title6" />
                                                                <Label id="CCForm_Label15" text="Record Quantity" tooltip="Record Quantity"/>
                                                                <CheckBox id="recordQuantity" selected="{DataModel>/recordQuantity}" tooltip="Record Quantity"/>
                                                                <Label id="CCForm_Label16" text="Actual Primary Costs" tooltip="Actual Primary Costs"/>
                                                                <CheckBox id="actualPrimaryCosts" selected="{DataModel>/actualPrimaryCosts}" tooltip="Actual Primary Costs"/>
                                                                <Label id="CCForm_Label17" text="Actual Secondary Costs" tooltip="Actual Secondary Costs"/>
                                                                <CheckBox id="actualSecondaryCosts" selected="{DataModel>/actualSecondaryCosts}" tooltip="Actual Secondary Costs"/>
                                                                <Label id="CCForm_Label18" text="Plan Primary Costs" tooltip="Plan Primary Costs"/>
                                                                <CheckBox id="planPrimaryCosts" selected="{DataModel>/planPrimaryCosts}" tooltip="Plan Primary Costs"/>

                                                                <core:Title id="CCForm_Title7" />
                                                                <Label id="CCForm_Label19" text="Plan Secondary Costs" tooltip="Plan Secondary Costs"/>
                                                                <CheckBox id="planSecondaryCosts" selected="{DataModel>/planSecondaryCosts}" tooltip="Plan Secondary Costs"/>
                                                                <Label id="CCForm_Label20" text="Actual Revenue" tooltip="Actual Revenue"/>
                                                                <CheckBox id="actualRevenue" selected="{DataModel>/actualRevenue}" tooltip="Actual Revenue"/>
                                                                <Label id="CCForm_Label21" text="Plan Revenue" tooltip="Plan Revenue"/>
                                                                <CheckBox id="planRevenue" selected="{DataModel>/planRevenue}" tooltip="Plan Revenue"/>
                                                                <Label id="CCForm_Label22" text="Commitment Update" tooltip="Commitment Update"/>
                                                                <CheckBox id="commitmentUpdate" selected="{DataModel>/commitmentUpdate}" tooltip="Commitment Update"/>
                                                        </f:content>
                                                </f:SimpleForm>
                                        </IconTabFilter>

                                </items>
                        </IconTabBar>
                </content>
                <footer>
                        <OverflowToolbar id="ots1Toolbar">
                                <Button id="ccMsgButton" icon="sap-icon://message-popup" text="{= ${ccMessageModel>/messages}.length }" press="onCCMessagePopoverPress">
                                        <dependents>
                                                <MessagePopover id="ccMsgPopover" items="{ccMessageModel>/messages}">
                                                        <MessageItem id="_IDGenMessageItem" type="{ccMessageModel>type}" title="{ccMessageModel>title}" description="{ccMessageModel>description}" />
                                                </MessagePopover>
                                        </dependents>
                                </Button>
                                <ToolbarSpacer id="ts1Spacer" />
                                <Button id="CCForm_Button" text="Submit" type="Emphasized" press="onSubmitCostCenter"/>
                                <Button id="CCForm_Button1" text="Cancel" press="onCancelCostCenter"/>
                        </OverflowToolbar>
                </footer>
        </Dialog>
</core:FragmentDefinition>
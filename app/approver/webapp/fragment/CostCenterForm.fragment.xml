<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout">

    <Dialog 
        resizable="true"
        draggable="true"
        contentHeight="100%"
        contentWidth="100%"
        afterClose="onDialogAfterClose">

        <content>
            <IconTabBar class="sapUiResponsiveContentPadding">

                <items>

                    <!-- Header -->
                    <IconTabFilter text="Header Data" icon="sap-icon://add-contact">

                        <f:SimpleForm editable="false"
                                      layout="ResponsiveGridLayout"
                                      labelSpanXL="4"
                                      labelSpanL="3"
                                      labelSpanM="12"
                                      columnsXL="2"
                                      columnsL="2"
                                      columnsM="1">

                            <f:content>

                                <Label text="Controlling Area"/>
                                <Input value="{line>/controllingArea}" editable="false"/>

                                <Label text="Cost Center"/>
                                <Input value="{line>/costCenter}" editable="false"/>

                                <Label text="Valid From"/>
                                <DatePicker
                                    value="{line>/validFrom}"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="long"
                                    editable="false" />

                                <Label text="Valid To"/>
                                <DatePicker
                                    value="{line>/validTo}"
                                    valueFormat="yyyy-MM-dd"
                                    displayFormat="long"
                                    editable="false" />

                            </f:content>
                        </f:SimpleForm>

                    </IconTabFilter>

                    <!-- Basic Data -->
                    <IconTabFilter text="Basic Data" icon="sap-icon://business-card">

                        <f:SimpleForm editable="false"
                                      layout="ResponsiveGridLayout"
                                      labelSpanXL="5"
                                      labelSpanL="4"
                                      labelSpanM="12"
                                      columnsXL="2"
                                      columnsL="2"
                                      columnsM="1">

                            <f:content>

                                <core:Title text="Basic Information"/>

                                <Label text="Name"/>
                                <Input value="{line>/name}" editable="false"/>

                                <Label text="Description"/>
                                <Input value="{line>/description}" editable="false"/>

                                <Label text="User Responsible"/>
                                <Input value="{line>/userResponsible}" editable="false"/>

                                <Label text="Person Responsible"/>
                                <Input value="{line>/personResponsible}" editable="false"/>

                                <Label text="Department"/>
                                <Input value="{line>/department}" editable="false"/>

                                <Label text="Cost Center Category"/>
                                <Input value="{line>/costCenterCategory}" editable="false"/>

                                <core:Title text="Organizational"/>

                                <Label text="Hierarchy Area"/>
                                <Input value="{line>/hierarchyArea}" editable="false"/>

                                <Label text="Company Code"/>
                                <Input value="{line>/companyCode}" editable="false"/>

                                <Label text="Business Area"/>
                                <Input value="{line>/businessArea}" editable="false"/>

                                <Label text="Currency"/>
                                <Input value="{line>/currency}" editable="false"/>

                                <Label text="Profit Center"/>
                                <Input value="{line>/profitCenter}" editable="false"/>

                            </f:content>
                        </f:SimpleForm>

                    </IconTabFilter>

                    <!-- Control -->
                    <IconTabFilter text="Control" icon="sap-icon://settings">

                        <f:SimpleForm
                            editable="false"
                            layout="ResponsiveGridLayout"
                            labelSpanXL="5"
                            labelSpanL="4"
                            labelSpanM="12"
                            columnsXL="2"
                            columnsL="2"
                            columnsM="1">

                            <f:content>

                                <Label text="Record Quantity"/>
                                <CheckBox selected="{line>/recordQuantity}" enabled="false"/>

                                <Label text="Actual Primary Costs"/>
                                <CheckBox selected="{line>/actualPrimaryCosts}" enabled="false"/>

                                <Label text="Actual Secondary Costs"/>
                                <CheckBox selected="{line>/actualSecondaryCosts}" enabled="false"/>

                                <Label text="Plan Primary Costs"/>
                                <CheckBox selected="{line>/planPrimaryCosts}" enabled="false"/>

                                <Label text="Plan Secondary Costs"/>
                                <CheckBox selected="{line>/planSecondaryCosts}" enabled="false"/>

                                <Label text="Actual Revenue"/>
                                <CheckBox selected="{line>/actualRevenue}" enabled="false"/>

                                <Label text="Plan Revenue"/>
                                <CheckBox selected="{line>/planRevenue}" enabled="false"/>

                                <Label text="Commitment Update"/>
                                <CheckBox selected="{line>/commitmentUpdate}" enabled="false"/>

                            </f:content>
                        </f:SimpleForm>

                    </IconTabFilter>

                </items>
            </IconTabBar>
        </content>

        <buttons>
            <Button text="Close" press="onCloseDialog"/>
        </buttons>

    </Dialog>
</core:FragmentDefinition>

<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:l="sap.ui.layout">

    <Dialog id="CostCenterForm_Dialog"
            resizable="true"
            draggable="true"
            contentHeight="100%"
            contentWidth="100%"
            afterClose="onDialogAfterClose">

        <content>
            <IconTabBar id="CostCenterForm_IconTabBar"
                        class="sapUiResponsiveContentPadding">

                <items>
                    <IconTabFilter id="Tab_Initial"
                                   text="Initial Screen"
                                   icon="sap-icon://add-contact"
                                   enabled="true">

                        <f:SimpleForm id="SimpleForm_Initial"
                                      editable="true"
                                      layout="ResponsiveGridLayout"
                                      labelSpanXL="4"
                                      labelSpanL="3"
                                      labelSpanM="12"
                                      labelSpanS="12"
                                      adjustLabelSpan="false"
                                      emptySpanXL="0"
                                      emptySpanL="0"
                                      emptySpanM="0"
                                      emptySpanS="0"
                                      columnsXL="2"
                                      columnsL="2"
                                      columnsM="1">

                            <f:content>

                                <Label id="CostCenterForm_Label1" text="Controlling Area"/>
                                <Input id="CostCenterForm_Input" value="{line>/controllingArea}" editable="false"/>

                                <Label id="CostCenterForm_Label2" text="Cost Center"/>
                                <Input id="CostCenterForm_Input1" value="{line>/costCenter}" editable="false"/>

                                <Label id="CostCenterForm_Label3" text="Valid From"/>
                                <DatePicker id="CostCenterForm_DatePicker" value="{line>/validFrom}"
                                            valueFormat="yyyy-MM-dd"
                                            displayFormat="long"
                                            editable="false" />

                            </f:content>
                        </f:SimpleForm>

                    </IconTabFilter>

                    <IconTabFilter id="Tab_BasicData"
                                   text="Basic Data"
                                   icon="sap-icon://business-card"
                                   enabled="true">

                        <f:SimpleForm id="SimpleForm_Basic"
                                      editable="true"
                                      layout="ResponsiveGridLayout"
                                      labelSpanXL="5"
                                      labelSpanL="4"
                                      labelSpanM="12"
                                      labelSpanS="12"
                                      columnsXL="2"
                                      columnsL="2"
                                      columnsM="1">

                            <f:content>

                                <core:Title id="CostCenterForm_Title" text="Basic Information"/>

                                <Label id="CostCenterForm_Label4" text="Name"/>
                                <Input id="CostCenterForm_Input2" value="{line>/name}" editable="false"/>

                                <Label id="CostCenterForm_Label5" text="Description"/>
                                <Input id="CostCenterForm_Input3" value="{line>/description}" editable="false"/>

                                <Label id="CostCenterForm_Label6" text="User Responsible"/>
                                <Input id="CostCenterForm_Input4" value="{line>/userResponsible}" editable="false"/>

                                <Label id="CostCenterForm_Label7" text="Person Responsible"/>
                                <Input id="CostCenterForm_Input5" value="{line>/personResponsible}" editable="false"/>

                                <Label id="CostCenterForm_Label8" text="Department"/>
                                <Input id="CostCenterForm_Input6" value="{line>/department}" editable="false"/>

                                <Label id="CostCenterForm_Label9" text="Cost Center Category"/>
                                <Input id="CostCenterForm_Input7" value="{line>/costCenterCategory}" editable="false"/>

                                <core:Title id="CostCenterForm_Title1" text="Organizational"/>

                                <Label id="CostCenterForm_Label10" text="Hierarchy Area"/>
                                <Input id="CostCenterForm_Input8" value="{line>/hierarchyArea}" editable="false"/>

                                <Label id="CostCenterForm_Label11" text="Company Code"/>
                                <Input id="CostCenterForm_Input9" value="{line>/companyCode}" editable="false"/>

                                <Label id="CostCenterForm_Label12" text="Business Area"/>
                                <Input id="CostCenterForm_Input10" value="{line>/businessArea}" editable="false"/>

                                <Label id="CostCenterForm_Label13" text="Currency"/>
                                <Input id="CostCenterForm_Input11" value="{line>/currency}" editable="false"/>

                                <Label id="CostCenterForm_Label14" text="Profit Center"/>
                                <Input id="CostCenterForm_Input12" value="{line>/profitCenter}" editable="false"/>

                            </f:content>

                        </f:SimpleForm>

                    </IconTabFilter>

                </items>
            </IconTabBar>
        </content>

        <buttons>
            <!-- Submit Removed -->
            <Button id="CostCenterForm_Button" text="Close"
                    press="onCloseDialog" />
        </buttons>

    </Dialog>
</core:FragmentDefinition>

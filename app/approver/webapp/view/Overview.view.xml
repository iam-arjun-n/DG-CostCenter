<mvc:View
    controllerName="com.deloitte.mdg.costcenter.approver.approver.controller.Overview"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
>
    <App id="Approval_App">
        <pages>
            <Page
                id="Approval_Page"
                showHeader="false"
                showFooter="false"
            >
                <content>
                    <Panel
                        id="Approval_Panel1"
                        expanded="true"
                        expandable="true"
                        width="auto"
                        class="sapUiResponsiveMargin"
                        headerText="Cost Center - {RequestType}"
                    >
                        <content>
                            <Table
                                id="Approval_CostCenterTable"
                                alternateRowColors="false"
                                mode="SingleSelectLeft"
                                items="{/costCenterData}"
                                selectionChange="onSelectionChange"
                            >
                                <columns>
                                    <Column id="Approval_Column1"><Label id="Approval_Label" text="Controlling Area"/></Column>
                                    <Column id="Approval_Column2"><Label id="Approval_Label1" text="Cost Center"/></Column>
                                    <Column id="Approval_Column3"><Label id="Approval_Label2" text="Name"/></Column>
                                    <Column id="Approval_Column4"><Label id="Approval_Label3" text="Description"/></Column>
                                </columns>

                                <items>
                                    <ColumnListItem id="Approval_ColumnListItem">
                                        <cells>
                                            <Text id="Approval_Text" text="{controllingArea}" />
                                            <Text id="Approval_Text1" text="{costCenter}" />
                                            <Text id="Approval_Text2" text="{name}" />
                                            <Text id="Approval_Text3" text="{description}" />
                                        </cells>
                                    </ColumnListItem>
                                </items>

                                <headerToolbar>
                                    <OverflowToolbar id="Approval_OverflowToolbar" width="100%">
                                        <content>
                                            <ToolbarSpacer id="Approval_ToolbarSpacer" />
                                            <Button
                                                id="Approval_Button_View"
                                                text="View"
                                                icon="sap-icon://detail-view"
                                                press="onViewLine"
                                                enabled="false"
                                            />
                                        </content>
                                    </OverflowToolbar>
                                </headerToolbar>
                            </Table>
                        </content>
                    </Panel>

                    <Panel id="Approval_Panel"
                        expanded="true"
                        expandable="true"
                        headerText="Comments"
                        width="auto"
                        class="sapUiResponsiveMargin"
                    >
                        <content>
                            <FeedInput
                                id="fIC"
                                post="onPostComment"
                                class="sapUiSmallMarginTopBottom"
                                maxLength="100"
                                placeholder="Add a comment - Character length limited to 100"
                            />
                            <List
                                showSeparators="Inner"
                                items="{commentModel>/}"
                                id="flist"
                            >
                                <FeedListItem id="Approval_FeedListItem"
                                    sender="{commentModel>UserName}"
                                    timestamp="{commentModel>Date}"
                                    text="{commentModel>Text}"
                                />
                            </List>
                        </content>
                    </Panel>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
